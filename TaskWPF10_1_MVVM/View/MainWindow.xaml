<Window x:Class="TaskWPF10_1_MVVM.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskWPF10_1_MVVM"
        xmlns:vm ="clr-namespace:TaskWPF10_1_MVVM.ViewModel"
        xmlns:cnvrt="clr-namespace:TaskWPF10_1_MVVM.Converters"
        mc:Ignorable="d"
        Title="MainWindow" Height="350" Width="450" MinHeight="350">
    <Window.DataContext>
        <vm:AuthorizationWindowVM/>
    </Window.DataContext>
    <Window.Resources>
        <cnvrt:BoolToColorBrushConverter x:Key="BoolToColorConverter"/>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.3*"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Text="Форма входа"
                   FontSize="24" FontWeight="Bold"
                   Margin="5"/>

        <TextBlock Grid.Column="0" Grid.Row="1"
           HorizontalAlignment="Center"
           VerticalAlignment="Center"
           Text="Логин:"/>

        <TextBox x:Name="Login"
                 Margin="10"
                 Grid.Row="1"
                 Grid.Column="1"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Text="{Binding Username}"/>

        <TextBlock Grid.Column="0" Grid.Row="2"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Text="Пароль:"/>

        <TextBox x:Name="Password"
                 Margin="10"
                 Grid.Row="2"
                 Grid.Column="1"
                 Height="30"
                 VerticalContentAlignment="Center"
                 Text="{Binding Password}"/>

        <Button x:Name="Authorization"
                Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="2"
                HorizontalAlignment="Center"
                VerticalContentAlignment="Center"
                Margin="10"
                Content="Войти"
                Height="40" Width="100"
                Command="{Binding LoginCommand}"/>
        
        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                VerticalAlignment="Center"
                Padding="15" Margin="20"
                Background="{Binding IsSuccess, Converter={StaticResource BoolToColorConverter}}"
                  CornerRadius="5">
            <TextBlock Text="{Binding StatusMessage}" 
                     Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                     VerticalAlignment="Center"
                     TextAlignment="Center"
                      FontSize="14" 
                     Foreground="White" FontWeight="Bold"/>
        </Border>
    </Grid>
</Window>
