<UserControl x:Class="TaskWPF11_1_UserControlExample.CircularProgressBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskWPF11_1_UserControlExample"
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="100">
    <Viewbox>
        <Grid Width="100" Height="100">
            <!-- Фон круга -->
            <Ellipse Stroke="LightGray" StrokeThickness="5" Fill="Transparent"/>

            <!-- Прогресс -->
            <Path Stroke="Blue" StrokeThickness="5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                <Path.Data>
                    <PathGeometry>
                        <PathFigure StartPoint="50,95" IsClosed="False">
                            <ArcSegment Point="{Binding ProgressEndPoint, RelativeSource={RelativeSource AncestorType=local:CircularProgressBar}}" 
                                        Size="45,45" 
                                        SweepDirection="Clockwise"
                                        IsLargeArc="{Binding IsLargeArc, RelativeSource={RelativeSource AncestorType=local:CircularProgressBar}}"/>
                        </PathFigure>
                    </PathGeometry>
                </Path.Data>
            </Path>

            <!-- Текст с процентом -->
            <TextBlock Text="{Binding PercentageText, RelativeSource={RelativeSource AncestorType=local:CircularProgressBar}}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontWeight="Bold"/>
        </Grid>
    </Viewbox>
</UserControl>
