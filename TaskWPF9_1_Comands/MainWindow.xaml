<Window x:Class="TaskWPF9_1_Comands.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskWPF9_1_Comands"
        mc:Ignorable="d"
        Title="MainWindow" Height="300" Width="500">
    <Window.CommandBindings>
        <CommandBinding Command="local:CustomCommands.ChangeColor" Executed="ChangeColorExecuted"/>
        <CommandBinding Command="ApplicationCommands.Undo" Executed="UndoExecuted" CanExecute="UndoCanExecute"/>
    </Window.CommandBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Действия">
                <MenuItem Header="Изменить цвет"
                          Command="local:CustomCommands.ChangeColor"/>
                <MenuItem Header="Отменить"
                          Command="ApplicationCommands.Undo"/>
            </MenuItem>
        </Menu>
        <Grid x:Name="Dock">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*"/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition Height="2*"/>
            </Grid.RowDefinitions>
            <Button Grid.Row="1" 
                    Width="300" 
                    Content="Изменить цвет"
                    Command="local:CustomCommands.ChangeColor"/>
            <Button Grid.Row="3" 
                    Width="300" 
                    Content="Отменить"
                    Command="ApplicationCommands.Undo"/>
        </Grid>
    </DockPanel>
</Window>
